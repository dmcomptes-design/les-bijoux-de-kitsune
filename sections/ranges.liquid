<section class="section creme">
  <div class="container stack" style="gap: 48px;">
    <div class="stack center" style="gap: 12px; align-items: center;">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.title }} <em>{{ section.settings.title_em }}</em></h2>
    </div>
    <div class="ranges">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="range-card" {{ block.shopify_attributes }}>
          <span class="badge badge-{{ block.settings.style }}">{{ block.settings.badge }}</span>
          <h3>{% if c != blank %}{{ c.title }}{% else %}{{ block.settings.badge }}{% endif %}</h3>
          <p class="muted" style="flex-grow: 1; font-size: 14px;">{{ block.settings.text }}</p>
          <span class="link-arrow">Voir la gamme</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Les trois gammes",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Nos univers" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Par où souhaitez-vous" },
    { "type": "text", "id": "title_em", "label": "Fin du titre (italique)", "default": "commencer votre voyage ?" }
  ],
  "blocks": [
    {
      "type": "range",
      "name": "Gamme",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "select", "id": "style", "label": "Couleur du badge", "default": "signature", "options": [
          { "value": "signature", "label": "Or (Signature)" },
          { "value": "essentiels", "label": "Violet (Essentiels)" },
          { "value": "selection", "label": "Contour (Sélection)" }
        ] },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Signature" },
        { "type": "textarea", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Les trois gammes", "blocks": [{ "type": "range" }, { "type": "range" }, { "type": "range" }] }]
}
{% endschema %}
