<div class="container">
  <div class="page-head">
    <h1>Rechercher</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="btn-row" style="width: 100%; max-width: 640px;">
      <label class="visually-hidden" for="q">Rechercher un bijou</label>
      <input id="q" type="search" name="q" value="{{ search.terms | escape }}" class="input" style="flex: 1 1 240px;" placeholder="Améthyste, bracelet, collier…">
      <input type="hidden" name="type" value="product">
      <button type="submit" class="btn btn-primary">Rechercher</button>
    </form>
  </div>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="muted" style="margin-bottom: 24px;">{{ search.results_count }} résultat{% if search.results_count > 1 %}s{% endif %}</p>
      <div class="grid grid-4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- endpaginate -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
