<section class="section dark quote-band">
  <div class="container">
    <blockquote>
      <p>« {{ section.settings.quote }} »</p>
      <footer>{{ section.settings.author }}</footer>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '/pages/contact' }}" class="btn btn-outline">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </blockquote>
  </div>
</section>

{% schema %}
{
  "name": "Citation",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Citation", "default": "Ce n'est pas le bracelet qu'elles portent. C'est ce qu'il leur rappelle chaque matin." },
    { "type": "text", "id": "author", "label": "Auteur", "default": "Denis, créateur des Bijoux de Kitsune" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Créer mon bijou sur demande" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" }
  ],
  "presets": [{ "name": "Citation" }]
}
{% endschema %}
