<div class="container center stack" style="align-items: center; justify-content: center; min-height: 100vh; gap: 24px;">
  <img src="{{ 'logo-bijoux-kitsune-prune.svg' | asset_url }}" alt="{{ shop.name }}" width="220" height="250">
  <h1>{{ 'general.password_page.title' | t }}</h1>
  {%- assign lead = 'general.password_page.lead' | t -%}
  <p class="lead">{{ shop.password_message | default: lead }}</p>
  {%- form 'storefront_password', class: 'btn-row', style: 'justify-content: center;' -%}
    <label class="visually-hidden" for="pw">{{ 'general.password_page.password' | t }}</label>
    <input id="pw" type="password" name="password" class="input" style="max-width: 260px;" placeholder="{{ 'general.password_page.password' | t }}">
    <button type="submit" class="btn btn-primary">{{ 'general.password_page.submit' | t }}</button>
    {%- if form.errors -%}<p class="form-error" style="width: 100%;">{{ form.errors | default_errors }}</p>{%- endif -%}
  {%- endform -%}
</div>
{% schema %}
{ "name": "Page mot de passe", "settings": [] }
{% endschema %}
