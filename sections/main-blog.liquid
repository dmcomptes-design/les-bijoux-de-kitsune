<div class="container">
  <div class="page-head"><h1>{{ blog.title }}</h1></div>
  {%- paginate blog.articles by 12 -%}
    <div class="grid">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card">
          {%- if article.image -%}<div class="art">{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}</div>{%- endif -%}
          <span class="card-name">{{ article.title }}</span>
          <span class="card-meta">{{ article.published_at | date: '%d/%m/%Y' }}</span>
        </a>
      {%- endfor -%}
    </div>
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
