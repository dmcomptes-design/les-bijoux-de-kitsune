<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1a1219">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
    <title>
      {{ page_title }}
      {%- if current_tags %} · {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} · page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} · {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {{ 'cormorant-garamond-latin-300-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ 'jost-latin-300-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    {% render 'ashiato' %}
    {% render 'structured-data' %}
  </head>
  <body class="template-{{ template.name }}">
    <a class="visually-hidden" href="#contenu">Aller au contenu</a>
    {% section 'header' %}
    <main id="contenu" class="site-main" role="main">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
  </body>
</html>
