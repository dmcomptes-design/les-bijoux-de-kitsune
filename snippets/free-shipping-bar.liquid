{%- comment -%} Barre de progression vers la livraison offerte. Utilise settings.free_shipping_threshold (en euros). {%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign show = false
  if threshold > 0 and cart.item_count > 0
    assign show = true
  endif
  assign remaining = threshold | minus: cart.total_price
  assign percent = 0
  if threshold > 0
    assign percent = cart.total_price | times: 100 | divided_by: threshold
  endif
  if percent > 100
    assign percent = 100
  endif
-%}
{%- if show -%}
  <div class="ship-bar{% if remaining <= 0 %} is-done{% endif %}">
    <p class="ship-bar-text" aria-live="polite">
      {%- if remaining > 0 -%}
        Plus que <strong>{{ remaining | money }}</strong> pour profiter de la livraison offerte.
      {%- else -%}
        <strong>La livraison vous est offerte.</strong>
      {%- endif -%}
    </p>
    <div class="ship-bar-track" role="progressbar" aria-label="Progression vers la livraison offerte" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}">
      <span class="ship-bar-fill" style="width: {{ percent }}%;"></span>
    </div>
  </div>
{%- endif -%}
